# n8n Production Environment Configuration
# Copy to .env and fill in actual values. Never commit the real .env.
# This file is git-ignored.

# ==== Database ====
DB_TYPE=postgresdb
# Neon PostgreSQL host (use the direct endpoint, not the pooler, for best compatibility with n8n migrations)
# Example: DB_POSTGRESDB_HOST=ep-super-hill-bde0se4s.neondb.tech
DB_POSTGRESDB_HOST=your-neon-host.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=neondb
DB_POSTGRESDB_USER=neondb_owner
DB_POSTGRESDB_PASSWORD=your-postgres-password
DB_POSTGRESDB_SCHEMA=n8n

# SSL configuration for Neon PostgreSQL
# Neon uses ISRG Root X1 (Let's Encrypt) which is trusted by default in the n8n image.
# Set to false only if you have a custom CA and know what you are doing.
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true

# ==== n8n Authentication & Identity ====
# Encryption key must remain consistent across deployments to preserve access to existing credentials.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-this-to-a-64-character-hex-string

# Public facing configuration (set these to match your domain/hosting)
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://n8n.example.com/
# Webhook URL (replaces deprecated WEBHOOK_URL from n8n < 2.35.0)
# This is the public URL that webhook nodes will use; must end with trailing slash
N8N_WEBHOOK_URL=https://n8n.example.com/
# WEBHOOK_URL is deprecated from n8n 2.35.0; n8n logs a deprecation warning if still used.
# Uncomment and set only if you are on an older n8n version.
# WEBHOOK_URL=https://n8n.example.com/

# Proxy & network
N8N_PROXY_HOPS=1
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# ==== Optional: Image pinning (overrides compose default) ====
# Set this to a specific n8n version tag (e.g., 2.48.6) to control upgrades deliberately.
# Leave blank to use the pinned default from compose.yaml (2.48.6).
# N8N_IMAGE_TAG=

# ==== Optional: TLS / Caddy ====
# Required when enabling the 'tls' profile in compose.yaml for automatic HTTPS.
# Set to your domain name (matching the DNS A record pointing to your server).
# N8N_DOMAIN=n8n.example.com